---
// A field of dots driven by a 2D wave equation: moving the pointer drags a finger across a
// vibrotactile membrane, clicking/tapping sends a pulse. Idle taps keep it alive.
---

<canvas class="tactile-field" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>(".tactile-field")!;
  const ctx = canvas.getContext("2d")!;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  const GAP = 22; // px between dots
  let W = 0, H = 0, cols = 0, rows = 0, dpr = 1;
  let cur = new Float32Array(0), prev = new Float32Array(0);
  let ink = "#15151a", accent = "#ff5530";
  let visible = true, last = performance.now(), idleTimer = 0;
  const pointer = { x: -1, y: -1, px: -1, py: -1, active: false };

  function readColors() {
    const cs = getComputedStyle(document.documentElement);
    ink = cs.getPropertyValue("--ink").trim() || ink;
    accent = cs.getPropertyValue("--accent").trim() || accent;
  }

  function resize() {
    const r = canvas.getBoundingClientRect();
    dpr = Math.min(devicePixelRatio || 1, 2);
    W = r.width; H = r.height;
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    cols = Math.ceil(W / GAP) + 2;
    rows = Math.ceil(H / GAP) + 2;
    cur = new Float32Array(cols * rows);
    prev = new Float32Array(cols * rows);
  }

  function poke(x: number, y: number, strength: number, radius = 2) {
    const cx = Math.round(x / GAP), cy = Math.round(y / GAP);
    for (let j = -radius; j <= radius; j++)
      for (let i = -radius; i <= radius; i++) {
        const gx = cx + i, gy = cy + j;
        if (gx < 1 || gy < 1 || gx >= cols - 1 || gy >= rows - 1) continue;
        const d = Math.hypot(i, j) / (radius + 0.5);
        if (d < 1) cur[gy * cols + gx] += strength * (1 - d * d);
      }
  }

  function step() {
    const next = prev; // reuse buffer
    const c2 = 0.24, damp = 0.985;
    for (let y = 1; y < rows - 1; y++)
      for (let x = 1; x < cols - 1; x++) {
        const k = y * cols + x;
        const lap = cur[k - 1] + cur[k + 1] + cur[k - cols] + cur[k + cols] - 4 * cur[k];
        next[k] = (2 * cur[k] - prev[k] + c2 * lap) * damp;
      }
    prev = cur;
    cur = next;
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    for (let y = 0; y < rows; y++)
      for (let x = 0; x < cols; x++) {
        const h = cur[y * cols + x];
        const a = Math.min(Math.abs(h), 1);
        const px = x * GAP - GAP / 2, py = y * GAP - GAP / 2 - h * 6;
        const r = 1.1 + a * 2.4;
        ctx.globalAlpha = 0.16 + a * 0.84;
        ctx.fillStyle = a > 0.12 ? accent : ink;
        ctx.beginPath();
        ctx.arc(px, py, r, 0, Math.PI * 2);
        ctx.fill();
      }
    ctx.globalAlpha = 1;
  }

  function frame(now: number) {
    if (visible) {
      const dt = Math.min(now - last, 50);
      if (pointer.active && pointer.px >= 0) {
        // Inject along the path travelled since the last frame
        const dist = Math.hypot(pointer.x - pointer.px, pointer.y - pointer.py);
        const n = Math.max(1, Math.ceil(dist / (GAP / 2)));
        for (let i = 1; i <= n; i++) {
          const t = i / n;
          poke(pointer.px + (pointer.x - pointer.px) * t, pointer.py + (pointer.y - pointer.py) * t, Math.min(dist / 40, 0.6), 1);
        }
      }
      pointer.px = pointer.x; pointer.py = pointer.y;
      idleTimer += dt;
      // Idle taps are autoplaying motion, so skip them when the user prefers reduced motion
      if (!reduce && idleTimer > 1800) {
        idleTimer = 0;
        poke(Math.random() * W, Math.random() * H, 2.2, 2);
      }
      step();
      draw();
    }
    last = now;
    requestAnimationFrame(frame);
  }

  const toLocal = (x: number, y: number) => {
    const r = canvas.getBoundingClientRect();
    return { x: x - r.left, y: y - r.top };
  };
  const moveTo = (x: number, y: number) => {
    const p = toLocal(x, y);
    if (!pointer.active) { pointer.px = p.x; pointer.py = p.y; }
    pointer.x = p.x; pointer.y = p.y; pointer.active = true; idleTimer = 0;
  };
  const release = () => { pointer.active = false; pointer.px = -1; };
  const tap = (x: number, y: number) => { const p = toLocal(x, y); poke(p.x, p.y, 6, 3); idleTimer = 0; };
  const onControl = (t: EventTarget | null) => !!(t as HTMLElement)?.closest?.("a,button");
  const host = canvas.parentElement!;

  // Mouse / pen
  host.addEventListener("pointermove", (e) => { if (e.pointerType !== "touch") moveTo(e.clientX, e.clientY); });
  host.addEventListener("pointerleave", (e) => { if (e.pointerType !== "touch") release(); });
  host.addEventListener("pointerdown", (e) => {
    if (e.pointerType !== "touch" && !onControl(e.target)) tap(e.clientX, e.clientY);
  });

  // Touch: passive touch events keep firing while the page scrolls (pointer events get cancelled),
  // so the ripple follows the finger even during a vertical swipe.
  host.addEventListener("touchstart", (e) => {
    const t = e.touches[0];
    if (!t || onControl(e.target)) return;
    tap(t.clientX, t.clientY);
    pointer.active = false;
    moveTo(t.clientX, t.clientY);
  }, { passive: true });
  host.addEventListener("touchmove", (e) => {
    const t = e.touches[0];
    if (t) moveTo(t.clientX, t.clientY);
  }, { passive: true });
  host.addEventListener("touchend", release, { passive: true });
  host.addEventListener("touchcancel", release, { passive: true });

  new ResizeObserver(resize).observe(canvas);
  new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);
  new MutationObserver(readColors).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", readColors);

  readColors();
  resize();
  // With reduced motion the surface stays still until the visitor touches it.
  if (!reduce) setTimeout(() => poke(W * 0.72, H * 0.45, 7, 3), 300); // opening ripple
  requestAnimationFrame(frame);
</script>

<style>
  .tactile-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }
</style>
