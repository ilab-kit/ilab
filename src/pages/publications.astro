---
import Base from "../layouts/Base.astro";
import { load, highlightAuthors } from "../lib/data.js";
import { parseAck, countCodes } from "../lib/ack.js";

const pubs = load("publications");
// ACK CODE filter options, grouped by prefix (NRF, IITP, ...) with newest year first
const ackCounts = countCodes(pubs);
const ackCodes = Object.keys(ackCounts).sort((a, b) => {
  const pa = a.replace(/\d+$/, ""), pb = b.replace(/\d+$/, "");
  return pa === pb ? b.localeCompare(a) : pa.localeCompare(pb);
});
const members = load("members");
const names = members.flatMap((m) => [m.name, m.ko].filter(Boolean));

const types = [
  { id: "all", label: "All" },
  { id: "journal", label: "SCIE Journals" },
  { id: "journal-other", label: "Other Int'l Journals" },
  { id: "journal-domestic", label: "Domestic Journals" },
  { id: "conference", label: "Int'l Conferences" },
  { id: "conference-domestic", label: "Domestic Conferences" },
];
const count = (id) => (id === "all" ? pubs.length : pubs.filter((p) => p.type === id).length);
const typeLabel = Object.fromEntries(types.map((t) => [t.id, t.label]));

// Group by year, newest first
const years = [...new Set(pubs.map((p) => p.year || 0))].sort((a, b) => b - a);
const scholar = (t) => `https://scholar.google.com/scholar?q=${encodeURIComponent(t)}`;
---

<Base title="Publications">
  <div class="container">
    <header class="page-head">
      <div class="eyebrow">Output</div>
      <h1>Publications</h1>
      <p><b>Bold</b> names are lab members. † equal contribution, * corresponding author.</p>
    </header>

    <div class="controls">
      <div class="tabs" role="group" aria-label="Filter by type">
        {types.map((t, i) => (
          <button class="tab" data-type={t.id} aria-pressed={i === 0 ? "true" : "false"}>
            {t.label}<span class="count">{count(t.id)}</span>
          </button>
        ))}
      </div>
      <div class="filters-row">
        <input class="search" type="search" placeholder="Search title, author, venue…" aria-label="Search publications" />
        <select class="select ack-select" aria-label="Filter by ACK CODE">
          <option value="">All ACK CODEs</option>
          {ackCodes.map((c) => <option value={c}>{c} ({ackCounts[c]})</option>)}
        </select>
        <span class="ack-active" hidden>
          ACK: <b></b>
          <button type="button" class="ack-clear" aria-label="Clear ACK filter">×</button>
        </span>
      </div>
    </div>

    <div class="list">
      {years.map((y) => (
        <section class="year-block" data-year={y}>
          <h2 class="year">{y || "—"}</h2>
          <ol>
            {pubs.filter((p) => (p.year || 0) === y).map((p) => (
              <li class="pub" data-type={p.type} data-ack={parseAck(p.ack).join(" ")} data-text={`${p.title} ${p.authors} ${p.venue}`.toLowerCase()}>
                <div class="pub-type">{typeLabel[p.type]}</div>
                <h3>
                  <a href={p.doi ? `https://doi.org/${p.doi}` : scholar(p.title)} target="_blank" rel="noopener">{p.title}</a>
                </h3>
                <p class="authors" set:html={highlightAuthors(p.authors, names)} />
                <p class="venue">{p.venue}</p>
                <div class="tags">
                  {p.impact && <span class="chip accent">{p.impact}</span>}
                  {p.notes?.map((n) => <span class="chip">{/award|nominee|상/i.test(n) ? `★ ${n}` : n}</span>)}
                  {p.pdf && <a class="chip" href={p.pdf}>PDF</a>}
                  {p.video && <a class="chip" href={p.video}>Video</a>}
                  {parseAck(p.ack).map((c) => <button type="button" class="chip ack-chip" data-ack-chip={c} title="Show outputs with this ACK CODE">ACK {c}</button>)}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
      <p class="empty" hidden>No publications match.</p>
    </div>
  </div>
</Base>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".tab");
  const search = document.querySelector<HTMLInputElement>(".search")!;
  const items = document.querySelectorAll<HTMLElement>(".pub");
  const blocks = document.querySelectorAll<HTMLElement>(".year-block");
  const empty = document.querySelector<HTMLElement>(".empty")!;
  const ackSelect = document.querySelector<HTMLSelectElement>(".ack-select")!;
  const ackActive = document.querySelector<HTMLElement>(".ack-active")!;
  let type = "all";
  let ack: Set<string> | null = null; // ACK CODEs to show; null = no ACK filter

  function setAck(codes: string[] | null) {
    ack = codes && codes.length ? new Set(codes) : null;
    ackSelect.value = ack && ack.size === 1 ? [...ack][0] : "";
    ackActive.hidden = !ack;
    ackActive.querySelector("b")!.textContent = ack ? [...ack].join(", ") : "";
    const params = new URLSearchParams(location.search);
    if (ack) params.set("ack", [...ack].join(","));
    else params.delete("ack");
    const qs = params.toString();
    history.replaceState(null, "", `${location.pathname}${qs ? `?${qs}` : ""}`);
    apply();
  }

  function apply() {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    items.forEach((el) => {
      const codes = el.dataset.ack ? el.dataset.ack.split(" ") : [];
      const ok =
        (type === "all" || el.dataset.type === type) &&
        (!q || el.dataset.text!.includes(q)) &&
        (!ack || codes.some((c) => ack!.has(c)));
      el.hidden = !ok;
      if (ok) shown++;
    });
    blocks.forEach((b) => (b.hidden = !b.querySelector(".pub:not([hidden])")));
    empty.hidden = shown > 0;
  }
  ackSelect.addEventListener("change", () => setAck(ackSelect.value ? [ackSelect.value] : null));
  ackActive.querySelector(".ack-clear")!.addEventListener("click", () => setAck(null));
  document.querySelectorAll<HTMLButtonElement>("[data-ack-chip]").forEach((b) =>
    b.addEventListener("click", () => {
      setAck([b.dataset.ackChip!]);
      document.querySelector(".controls")?.scrollIntoView({ block: "start" });
    })
  );
  tabs.forEach((t) =>
    t.addEventListener("click", () => {
      type = t.dataset.type!;
      tabs.forEach((x) => x.setAttribute("aria-pressed", String(x === t)));
      apply();
    })
  );
  search.addEventListener("input", apply);

  // Deep links: /publications?type=journal and /publications?ack=NRF24,NRF25
  const params = new URLSearchParams(location.search);
  const pre = params.get("type");
  if (pre) document.querySelector<HTMLButtonElement>(`.tab[data-type="${pre}"]`)?.click();
  const preAck = params.get("ack");
  if (preAck) setAck(preAck.split(",").map((s) => s.trim()).filter(Boolean));
</script>

<style>
  .controls {
    position: sticky;
    top: 64px;
    z-index: 5;
    background: var(--bg);
    padding: 12px 0 4px;
    margin-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .controls .tabs {
    margin-bottom: 12px;
  }
  .filters-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .ack-active {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 6px 4px 12px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 12.5px;
  }
  .ack-clear {
    appearance: none;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    padding: 0 4px;
  }
  .ack-chip {
    border: 0;
    font-family: var(--mono);
    font-size: 11.5px;
    cursor: pointer;
  }
  .ack-chip:hover {
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .controls { position: static; }
  }
  .year-block {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }
  .year {
    position: sticky;
    top: 200px;
    align-self: start;
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.04em;
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 720px) {
    .year-block { grid-template-columns: 1fr; gap: 8px; }
    .year { position: static; font-size: 28px; }
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
  }
  .pub-type {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }
  .pub h3 {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 4px;
  }
  .pub h3 a {
    text-decoration: none;
  }
  .authors {
    font-size: 14px;
    color: var(--muted);
    margin: 0 0 2px;
  }
  .authors :global(b) {
    color: var(--ink);
  }
  .venue {
    font-size: 14px;
    font-style: italic;
    color: var(--muted);
    margin: 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }
  .tags:empty {
    display: none;
  }
  .tags a {
    text-decoration: none;
  }
</style>
