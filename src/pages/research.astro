---
import Base from "../layouts/Base.astro";
import { load, img, highlightAuthors } from "../lib/data.js";

const research = load("research");
const members = load("members");
const names = members.flatMap((m) => [m.name, m.ko].filter(Boolean));
---

<Base title="Research" description="Haptic interfaces, varifocal lenses, haptic rendering & XR, soft robotics and physical AI.">
  <div class="container">
    <header class="page-head">
      <div class="eyebrow">Research</div>
      <h1>What we work on</h1>
      <p>Next-generation interfaces built from smart materials — surfaces that sense and give touch feedback, lenses that change shape, and robots that adapt to what they hold.</p>
    </header>

    <div class="layout">
      <nav class="toc" aria-label="Research areas">
        {research.map((a, i) => (
          <a href={`#${a.id}`} data-toc={a.id}><span>0{i + 1}</span>{a.title}</a>
        ))}
      </nav>

      <div class="areas">
        {research.map((a, i) => (
          <section id={a.id} class="area" data-area>
            {a.aliases?.map((al) => <span id={al} class="alias-anchor" aria-hidden="true" />)}
            <div class="area-head reveal">
              <div class="num">0{i + 1}</div>
              <h2>{a.title}</h2>
              <div class="ko">{a.ko}</div>
              <p>{a.summary}</p>
            </div>

            {a.works.map((w) => (
              <article class:list={["work reveal", { "no-media": !w.images?.length }]}>
                {w.images?.length > 0 && (
                  <div class="gallery" data-gallery>
                    <div class="track">
                      {w.images.map((src) => (
                        <button class="shot" data-zoom={img(src)} aria-label="Enlarge image">
                          <img src={img(src)} alt={w.title} loading="lazy" />
                        </button>
                      ))}
                    </div>
                    {w.images.length > 1 && (
                      <div class="dots">
                        {w.images.map((_, k) => <span class:list={{ on: k === 0 }} />)}
                      </div>
                    )}
                  </div>
                )}
                <div class="work-body">
                  <div class="meta">
                    <span class="chip accent">{w.year}</span>
                    <span class="venue">{w.venue}</span>
                    {w.status && <span class="chip status">{w.status}</span>}
                  </div>
                  <h3>{w.title}</h3>
                  {w.authors && <p class="authors" set:html={highlightAuthors(w.authors, names)} />}
                  {w.summary && <p class="work-summary">{w.summary}</p>}
                  {w.abstract && (
                    <details>
                      <summary>Abstract</summary>
                      <p>{w.abstract}</p>
                    </details>
                  )}
                  {w.related?.length > 0 && (
                    <div class="related">
                      <div class="related-label">Related public outputs</div>
                      <ul>{w.related.map((r) => <li>{r}</li>)}</ul>
                    </div>
                  )}
                  {w.videos && (
                    <div class="videos">
                      {w.videos.map((v, k) => (
                        <button class="video-btn" data-video={v}>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                          Play video{w.videos.length > 1 ? ` ${k + 1}` : ""}
                        </button>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </section>
        ))}
      </div>
    </div>
  </div>

  <dialog id="lightbox">
    <button class="close" aria-label="Close">×</button>
    <div class="lb-content"></div>
  </dialog>
</Base>

<script>
  // Gallery dots follow scroll position
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((g) => {
    const track = g.querySelector<HTMLElement>(".track")!;
    const dots = g.querySelectorAll(".dots span");
    if (!dots.length) return;
    track.addEventListener("scroll", () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      dots.forEach((d, k) => d.classList.toggle("on", k === i));
    }, { passive: true });
    dots.forEach((d, k) => d.addEventListener("click", () => track.scrollTo({ left: k * track.clientWidth, behavior: "smooth" })));
  });

  // Lightbox for images and videos
  const lb = document.getElementById("lightbox") as HTMLDialogElement;
  const content = lb.querySelector(".lb-content")!;
  const open = (html: string) => { content.innerHTML = html; lb.showModal(); };
  lb.addEventListener("close", () => (content.innerHTML = ""));
  lb.querySelector(".close")!.addEventListener("click", () => lb.close());
  lb.addEventListener("click", (e) => e.target === lb && lb.close());
  document.querySelectorAll<HTMLElement>("[data-zoom]").forEach((b) =>
    b.addEventListener("click", () => open(`<img src="${b.dataset.zoom}" alt="">`))
  );
  document.querySelectorAll<HTMLElement>("[data-video]").forEach((b) =>
    b.addEventListener("click", () => open(`<iframe src="${b.dataset.video}" allow="autoplay; fullscreen" allowfullscreen></iframe>`))
  );

  // Highlight current area in the side index
  const links = document.querySelectorAll<HTMLElement>("[data-toc]");
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) links.forEach((l) => l.classList.toggle("active", l.dataset.toc === e.target.id));
    });
  }, { rootMargin: "-40% 0px -55% 0px" });
  document.querySelectorAll("[data-area]").forEach((s) => io.observe(s));
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 48px;
  }
  .toc {
    position: sticky;
    top: 96px;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .toc a {
    display: flex;
    gap: 12px;
    padding: 8px 12px;
    border-radius: 10px;
    text-decoration: none;
    color: var(--muted);
    font-size: 15px;
    border-left: 2px solid transparent;
    transition: all 0.25s;
  }
  .toc a span {
    font-family: var(--mono);
    font-size: 12px;
    padding-top: 2px;
  }
  .toc a.active {
    color: var(--ink);
    background: var(--surface);
    border-left-color: var(--accent);
  }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; gap: 0; }
    .toc {
      top: 64px;
      z-index: 5;
      flex-direction: row;
      overflow-x: auto;
      background: var(--bg);
      padding: 8px 0;
      margin: 0 -16px;
      padding-left: 16px;
      scrollbar-width: none;
    }
    .toc a { white-space: nowrap; border-left: 0; }
  }
  .alias-anchor {
    display: block;
    scroll-margin-top: 96px;
  }
  .area {
    scroll-margin-top: 96px;
    padding-bottom: 72px;
  }
  .area-head {
    margin-bottom: 32px;
  }
  .num {
    font-family: var(--mono);
    color: var(--accent);
    font-size: 14px;
  }
  .area-head h2 {
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 600;
    margin: 4px 0 2px;
  }
  .ko {
    color: var(--muted);
    margin-bottom: 12px;
  }
  .area-head p {
    color: var(--muted);
    max-width: 640px;
  }
  .work {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 28px;
    padding: 28px 0;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 760px) {
    .work { grid-template-columns: 1fr; gap: 16px; }
  }
  .work.no-media {
    grid-template-columns: 1fr;
  }
  .work.no-media .work-body {
    max-width: 760px;
  }
  .gallery {
    position: relative;
  }
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar { display: none; }
  .shot {
    flex: 0 0 100%;
    scroll-snap-align: start;
    aspect-ratio: 4 / 3;
    border: 0;
    padding: 12px;
    background: transparent;
    cursor: zoom-in;
  }
  .shot img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 10px;
  }
  .dots span {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: var(--line);
    cursor: pointer;
    transition: all 0.3s;
  }
  .dots span.on {
    width: 18px;
    background: var(--accent);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .venue {
    font-size: 14px;
    color: var(--muted);
    font-style: italic;
  }
  .status {
    background: transparent;
    border: 1px dashed var(--line);
  }
  .work-summary {
    font-size: 15px;
    color: var(--muted);
    margin: 4px 0 12px;
  }
  .related {
    border-top: 1px dashed var(--line);
    padding-top: 10px;
    margin-bottom: 12px;
  }
  .related-label {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 6px;
  }
  .related ul {
    margin: 0;
    padding-left: 18px;
    font-size: 13.5px;
    color: var(--muted);
  }
  .related li {
    margin-bottom: 3px;
  }
  .work h3 {
    font-size: 20px;
    line-height: 1.35;
    font-weight: 600;
  }
  .authors {
    font-size: 14px;
    color: var(--muted);
  }
  .authors :global(b) {
    color: var(--ink);
    font-weight: 600;
  }
  details {
    border-top: 1px dashed var(--line);
    padding-top: 10px;
  }
  summary {
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
    list-style: none;
  }
  summary::before {
    content: "+ ";
    font-family: var(--mono);
  }
  details[open] summary::before {
    content: "− ";
  }
  details p {
    font-size: 14.5px;
    color: var(--muted);
    margin-top: 10px;
  }
  .videos {
    display: flex;
    gap: 8px;
    margin-top: 14px;
    flex-wrap: wrap;
  }
  .video-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    padding: 7px 14px;
    border-radius: 999px;
    font: inherit;
    font-size: 13.5px;
    cursor: pointer;
  }
  .video-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  dialog {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(1100px, 94vw);
    width: 100%;
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 0.75);
    backdrop-filter: blur(4px);
  }
  .lb-content :global(img) {
    max-height: 86vh;
    margin: 0 auto;
    background: #fff;
    border-radius: 12px;
    padding: 12px;
  }
  .lb-content :global(iframe) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 12px;
    background: #000;
  }
  .close {
    position: fixed;
    top: 16px;
    right: 20px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: rgb(255 255 255 / 0.15);
    color: #fff;
    font-size: 28px;
    cursor: pointer;
  }
</style>
