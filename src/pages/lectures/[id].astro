---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import MediaLightbox from "../../components/MediaLightbox.astro";
import { load, url, termLabel } from "../../lib/data.js";

export function getStaticPaths() {
  const courses = load("lectures");
  return courses.map((c, i) => ({
    params: { id: c.id },
    props: { course: c, newer: courses[i - 1] || null, older: courses[i + 1] || null },
  }));
}

const { course: c, newer, older } = Astro.props;
const l = termLabel(c.term);
const projects = c.projects || [];
---

<Base title={`${c.name} (${l.ko})`} description={`${l.ko} ${c.name} 학생 프로젝트 ${projects.length}개`}>
  <div class="container">
    <header class="page-head">
      <a class="back" href={url("/lectures")}>← Lectures</a>
      <div class="eyebrow">{l.en} · {l.ko}</div>
      <h1>{c.name}</h1>
      <p>{c.en}{projects.length > 0 && ` · ${projects.length} student projects`}</p>
    </header>

    {projects.length > 0 ? (
      <div class="grid">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    ) : (
      <p class="empty">아직 등록된 학생 프로젝트가 없습니다.</p>
    )}

    <nav class="pager" aria-label="Other courses">
      {older ? (
        <a href={url(`/lectures/${older.id}`)}>
          <span>← {termLabel(older.term).ko}</span>
          {older.name}
        </a>
      ) : <span />}
      {newer ? (
        <a href={url(`/lectures/${newer.id}`)} class="next">
          <span>{termLabel(newer.term).ko} →</span>
          {newer.name}
        </a>
      ) : <span />}
    </nav>
  </div>
  <MediaLightbox />
</Base>

<style>
  .back {
    display: inline-block;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 20px;
  }
  .back:hover {
    color: var(--accent);
  }
  .page-head h1 {
    font-size: clamp(30px, 5vw, 52px);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }
  @media (max-width: 400px) {
    .grid { grid-template-columns: 1fr; }
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    font-weight: 500;
    max-width: 48%;
  }
  .pager a span {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  .pager .next {
    text-align: right;
    align-items: flex-end;
  }
</style>
