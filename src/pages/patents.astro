---
import Base from "../layouts/Base.astro";
import { load, highlightAuthors } from "../lib/data.js";
import { parseAck, countCodes } from "../lib/ack.js";

const patents = load("patents");
const ackCounts = countCodes(patents);
const ackCodes = Object.keys(ackCounts).sort();
const members = load("members");
const names = members.flatMap((m) => [m.name, m.ko].filter(Boolean));
const tabs = [
  { id: "all", label: "All" },
  { id: "international", label: "International" },
  { id: "registered", label: "Registered (KR)" },
  { id: "applied", label: "Applied (KR)" },
];
const count = (id) => (id === "all" ? patents.length : patents.filter((p) => p.status === id).length);
const label = { international: "International", registered: "Registered", applied: "Applied" };
// newest first by date; international (no date) stays on top
const sorted = [...patents].sort((a, b) => (b.date || "9999").localeCompare(a.date || "9999"));
---

<Base title="Patents">
  <div class="container">
    <header class="page-head">
      <div class="eyebrow">Output</div>
      <h1>Patents</h1>
      <p>{count("international")} international and {count("registered")} registered Korean patents, {count("applied")} pending.</p>
    </header>

    <div class="tabs" role="group" aria-label="Filter patents">
      {tabs.map((t, i) => (
        <button class="tab" data-f={t.id} aria-pressed={i === 0 ? "true" : "false"}>
          {t.label}<span class="count">{count(t.id)}</span>
        </button>
      ))}
      <select class="select ack-select" aria-label="Filter by ACK CODE">
        <option value="">All ACK CODEs</option>
        {ackCodes.map((c) => <option value={c}>{c} ({ackCounts[c]})</option>)}
      </select>
      <span class="ack-active" hidden>
        ACK: <b></b>
        <button type="button" class="ack-clear" aria-label="Clear ACK filter">×</button>
      </span>
    </div>

    <ul class="list">
      {sorted.map((p) => (
        <li data-status={p.status} data-ack={parseAck(p.ack).join(" ")} class="reveal">
          <div class="side">
            <span class:list={["chip", { accent: p.status !== "applied" }]}>{label[p.status]}</span>
            {p.date && <span class="date">{p.date}</span>}
          </div>
          <div>
            <h3>{p.title}</h3>
            <p class="authors" set:html={highlightAuthors(p.authors, names)} />
            <div class="num">{p.status === "applied" ? "App. No." : p.status === "registered" ? "Reg. No." : ""} {p.number}</div>
            {p.ack && (
              <div class="acks">
                {parseAck(p.ack).map((c) => <button type="button" class="chip ack-chip" data-ack-chip={c} title="Show outputs with this ACK CODE">ACK {c}</button>)}
              </div>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</Base>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".tab");
  const ackSelect = document.querySelector<HTMLSelectElement>(".ack-select")!;
  const ackActive = document.querySelector<HTMLElement>(".ack-active")!;
  let status = "all";
  let ack: Set<string> | null = null;

  function apply() {
    document.querySelectorAll<HTMLElement>("[data-status]").forEach((li) => {
      const codes = li.dataset.ack ? li.dataset.ack.split(" ") : [];
      li.hidden = (status !== "all" && li.dataset.status !== status) || (!!ack && !codes.some((c) => ack!.has(c)));
    });
  }
  function setAck(codes: string[] | null) {
    ack = codes && codes.length ? new Set(codes) : null;
    ackSelect.value = ack && ack.size === 1 ? [...ack][0] : "";
    ackActive.hidden = !ack;
    ackActive.querySelector("b")!.textContent = ack ? [...ack].join(", ") : "";
    const params = new URLSearchParams(location.search);
    if (ack) params.set("ack", [...ack].join(","));
    else params.delete("ack");
    const qs = params.toString();
    history.replaceState(null, "", `${location.pathname}${qs ? `?${qs}` : ""}`);
    apply();
  }
  tabs.forEach((t) =>
    t.addEventListener("click", () => {
      status = t.dataset.f!;
      tabs.forEach((x) => x.setAttribute("aria-pressed", String(x === t)));
      apply();
    })
  );
  ackSelect.addEventListener("change", () => setAck(ackSelect.value ? [ackSelect.value] : null));
  ackActive.querySelector(".ack-clear")!.addEventListener("click", () => setAck(null));
  document.querySelectorAll<HTMLButtonElement>("[data-ack-chip]").forEach((b) => b.addEventListener("click", () => setAck([b.dataset.ackChip!])));
  const preAck = new URLSearchParams(location.search).get("ack");
  if (preAck) setAck(preAck.split(",").map((s) => s.trim()).filter(Boolean));
</script>

<style>
  .ack-active {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 6px 4px 12px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 12.5px;
  }
  .ack-clear {
    appearance: none;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    padding: 0 4px;
  }
  .acks {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }
  .ack-chip {
    border: 0;
    font-family: var(--mono);
    font-size: 11.5px;
    cursor: pointer;
  }
  .ack-chip:hover {
    color: var(--accent);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  li {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 24px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
  .date,
  .num {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--muted);
  }
  h3 {
    font-size: 16.5px;
    font-weight: 600;
    line-height: 1.45;
    margin-bottom: 4px;
  }
  .authors {
    font-size: 14px;
    color: var(--muted);
    margin: 0 0 4px;
  }
  .authors :global(b) {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    li { grid-template-columns: 1fr; gap: 8px; }
    .side { flex-direction: row; align-items: center; }
  }
</style>
